# ══════════════════════════════════════════════════════════════════════════════
# EugineBill Environment Configuration Template (.env.example)
# Copy this file to .env and configure values before starting the application.
# ══════════════════════════════════════════════════════════════════════════════

# 1. Database Connection (MySQL / MariaDB)
DATABASE_URL="mysql://eugineuser:StrongPasswordHere@localhost:3306/euginebill?connection_limit=10&pool_timeout=20"

# 2. Timezone Configuration (Mandatory WIB for Indonesian ISP)
TZ="Asia/Jakarta"
NEXT_PUBLIC_TIMEZONE="Asia/Jakarta"

# 3. Application Branding & Public URL
NEXT_PUBLIC_APP_NAME="EugineBill"
NEXT_PUBLIC_APP_URL="https://billing.domainanda.com"

# 4. Server Public IP & RADIUS Configuration
# Used by ONT Remote Proxy (socat) and MikroTik setup generators
VPS_PUBLIC_IP="YOUR_VPS_PUBLIC_IP"
RADIUS_SERVER_IP="YOUR_VPS_PUBLIC_IP"

# 5. Persistent File Upload Storage
# CRITICAL: Do NOT save inside public/uploads or process.cwd() as npm run build wipes it.
UPLOAD_DIR="/var/data/EugineBill/uploads"

# 6. Security Keys & Tokens
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="https://billing.domainanda.com"
AGENT_JWT_SECRET="generate-with-openssl-rand-base64-32"
TECHNICIAN_JWT_SECRET="generate-with-openssl-rand-base64-32"

# 32-character hex encryption key for sensitive MikroTik/VPN credentials at rest
# Generate with: openssl rand -hex 16
ENCRYPTION_KEY="generate-with-openssl-rand-hex-16"

# 7. GenieACS — TR-069 ACS Integration (Optional / Auto-provisioning)
GENIEACS_NBI_INTERNAL_URL="http://127.0.0.1:7557"
NEXT_PUBLIC_GENIEACS_NBI_URL="http://YOUR_VPS_IP:7557"
NEXT_PUBLIC_GENIEACS_CWMP_URL="http://YOUR_VPS_IP:7547"
NEXT_PUBLIC_GENIEACS_FS_URL="http://YOUR_VPS_IP:7567"
GENIEACS_MONGODB_URL="mongodb://127.0.0.1:27017/genieacs"
GENIEACS_NBI_USERNAME=""
GENIEACS_NBI_PASSWORD=""
GENIEACS_SESSION_TIMEOUT="3600"
GENIEACS_DEFAULT_CHANNEL="default"
NEXT_PUBLIC_GENIEACS_POLL_INTERVAL="30000"

# 8. Web Push Notifications (PWA)
# Generate keys with: node scripts/generate-vapid.js
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_CONTACT_EMAIL="admin@domainanda.com"

# 9. Dynamic QRIS / Notification Listener (Optional)
QRIS_STATIC_CODE="00020101021126..."
QRIS_NOTIFY_SECRET="your-qris-listener-secret"
